# Copy this file to .env.local or .env and fill in the real values.
# Do NOT commit real credentials to version control.

# Supabase (required for auth and database features)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Google Generative AI (optional — required for Google AI features)
VITE_GOOGLE_AI_KEY=your-google-generative-ai-api-key

# Optional: change dev server port (if you want to override default 5175)
# VITE_DEV_PORT=5175

# Notes:
# - Use .env.local for local-only secrets. Vite exposes variables that start with VITE_ to the client.
# - After adding/updating the env file, restart the dev server: `npm run dev`.