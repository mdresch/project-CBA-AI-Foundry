               const time = new Date(userMessage.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });\n\n                if (!summary[date]) {\n                    summary[date] = [];\n                }\n                summary[date].push({\n                    id: userMessage.id,\n                    content: userMessage.content,\n                    time: time,\n                    sessionId: session.id,\n                    userId: userId //Add User ID\n                });\n            }\n        });\n        setChatSummary(summary);\n    };\n. Focus on . Provide examples of how to use it.\n{{code}}: const AuthDialog = () => (\n        <Dialog open={showAuthDialog} onOpenChange={setShowAuthDialog}>\n            <DialogContent>\n                <DialogHeader>\n                    <DialogTitle>Authentication Required</DialogTitle>\n                    <DialogDescription>\n                        Please log in or create an account to use the chat feature.\n                    </DialogDescription>\n                </DialogHeader>\n                <div className="flex justify-end gap-4 mt-4">\n                    <a\n                        href="/login"\n                        className={`px-4 py-2 rounded-lg ${isDarkTheme\n                            ? 'bg-white text-black hover:bg-gray-200'\n                            : 'bg-gray-900 text-white hover:bg-gray-800'\n                            }`}\n                    >\n                        Log In\n                    </a>\n                    <a\n                        href="/signup"\n                        className={`px-4 py-2 rounded-lg ${isDarkTheme\n                            ? 'bg-zinc-800 text-white hover:bg-zinc-700'\n                            : 'bg-gray-200 text-gray-900 hover:bg-gray-300'\n                            }`}\n                    >\n                        Sign Up\n                    </a>\n                </div>\n            </DialogContent>\n        </Dialog>\n    );\n\n    if (!user) {\n        return <AuthDialog />;\n    }\n\n    const userId = user?.id;\n\n     const calculateChatSummary = () => {\n        const summary: {\n            [date: string]: { id: string; content: string; time: string; sessionId: string; userId: string }[]; //Add userId\n        } = {};\n\n        chatSessions.forEach((session) => {\n            const userMessage = session.messages.find((msg) => msg.role === 'user');\n            if (userMessage) {\n                const date = new Date(userMessage.timestamp).toLocaleDateString();\n                const time = new Date(userMessage.timestamp).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });\n\n                if (!summary[date]) {\n                    summary[date] = [];\n                }\n                summary[date].push({\n                    id: userMessage.id,\n                    content: userMessage.content,\n                    time: time,\n                    sessionId: session.id,\n                    userId: userId //Add User ID\n                });\n            }\n        });\n        setChatSummary(summary);\n    };\n\n{{aspects}}: 	user	2025-02-24 05:51:00.89+00	3b	gemini-pro
