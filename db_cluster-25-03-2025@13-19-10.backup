--
-- Name: chat_sessions Allow users to insert new chat sessions for themselves; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow users to insert new chat sessions for themselves" ON public.chat_sessions FOR INSERT WITH CHECK ((auth.uid() = user_id));


--
-- Name: messages Allow users to insert new messages into their own chat sessions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow users to insert new messages into their own chat sessions" ON public.messages FOR INSERT WITH CHECK ((EXISTS ( SELECT 1
   FROM public.chat_sessions
  WHERE ((chat_sessions.id = messages.session_id) AND (chat_sessions.user_id = auth.uid())))));


--
-- Name: messages Allow users to select messages in their own chat sessions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow users to select messages in their own chat sessions" ON public.messages FOR SELECT USING ((EXISTS ( SELECT 1
   FROM public.chat_sessions
  WHERE ((chat_sessions.id = messages.session_id) AND (chat_sessions.user_id = auth.uid())))));


--
-- Name: chat_sessions Allow users to select their own chat sessions; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Allow users to select their own chat sessions" ON public.chat_sessions FOR SELECT USING ((auth.uid() = user_id));


--
-- Name: profiles Profiles are viewable by everyone; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Profiles are viewable by everyone" ON public.profiles FOR SELECT USING (true);


--
-- Name: userpromptlibrary Users can access their own prompts; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can access their own prompts" ON public.userpromptlibrary TO authenticated USING ((user_id = auth.uid()));


--
-- Name: profiles Users can create their own profile; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can create their own profile" ON public.profiles FOR INSERT WITH CHECK ((auth.uid() = id));


--
-- Name: profiles Users can delete their own profile; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can delete their own profile" ON public.profiles FOR DELETE USING ((auth.uid() = id));


--
-- Name: profiles Users can update their own profile; Type: POLICY; Schema: public; Owner: postgres
--

CREATE POLICY "Users can update their own profile" ON public.profiles FOR UPDATE USING ((auth.uid() = id));


